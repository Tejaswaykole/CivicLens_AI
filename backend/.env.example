# Copy this file to backend/.env for local development.
# Replace every placeholder. Never commit backend/.env or real credentials.

# development | test | production
APP_ENV=development
APP_NAME=CivicLens AI

# PostgreSQL URL. The application normalizes postgresql:// to postgresql+psycopg://.
# Hosted PostgreSQL (including Supabase) usually requires sslmode=require in this URL.
# Do not disable TLS certificate verification.
DATABASE_URL=postgresql+psycopg://USERNAME:PASSWORD@localhost:5432/civiclens

# Comma-separated browser origins. Do not use * together with credentials.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_CREDENTIALS=false

# Optional label used by the explicit seed command. This is not a password.
SEED_LABEL=development

# Listen address. Pass this same value to Uvicorn:
# uvicorn app.main:app --host 127.0.0.1 --port 8000
# 127.0.0.1, localhost, ::1, and other 127.0.0.0/8 addresses are loopback and
# match each other. Startup reads Uvicorn's --host and refuses to serve when
# it does not match API_HOST. A public --host such as 0.0.0.0 requires a strong
# JWT_SECRET even if this value stays on loopback. The application never
# invents a secret. APP_ENV=production also requires that secret.
API_HOST=127.0.0.1

# HS256 signing secret. Generate one locally and keep it out of git:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
# The placeholder below is rejected. It must be at least 32 characters and
# contain at least 8 distinct characters.
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Production hides /docs, /redoc, and /openapi.json unless this is true.
ENABLE_API_DOCS=false

# In-process limits for the public auth routes. Restarting the process clears
# them. They are not shared across workers or hosts.
AUTH_LOGIN_RATE_LIMIT=10/minute
AUTH_REGISTER_RATE_LIMIT=5/minute

# Development and test only. When true, registration can return
# dev_verification_token so you can call /auth/verify-email. Production
# refuses to start if this is true. No email is sent.
EMAIL_VERIFICATION_DEBUG=false
EMAIL_VERIFICATION_TTL_HOURS=24

# Reserved for a future email provider. Delivery is not implemented.
# Leave these empty. Do not put real credentials in this file.
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=

# Optional. When this is 12-128 characters, python -m app.seed stores only
# its Argon2id hash on the fictional dev accounts. Leave it empty to create
# accounts that cannot log in. Never commit a real password.
SEED_DEV_PASSWORD=
