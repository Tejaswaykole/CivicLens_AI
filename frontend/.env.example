# CivicLens AI - Environment Configuration Example
# Copy this file to .env or .env.local for local overrides.
# DO NOT COMMIT REAL SECRETS OR SENSITIVE PRODUCTION CREDENTIALS.

# Application metadata
VITE_APP_TITLE=CivicLens AI
VITE_APP_ENV=development
VITE_APP_VERSION=0.1.0

# API Endpoints (Future Backend / Phase 2 integration)
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Development Mode Flags
VITE_ENABLE_DEV_ROLE_SWITCHER=true
VITE_ENABLE_MOCK_DATA=true
